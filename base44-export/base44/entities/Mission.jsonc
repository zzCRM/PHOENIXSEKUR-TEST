{
  "name": "Mission",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "gardiennage",
        "surveillance",
        "intervention",
        "ronde",
        "evenementiel"
      ],
      "default": "gardiennage"
    },
    "status": {
      "type": "string",
      "enum": [
        "planifiee",
        "en_cours",
        "terminee",
        "annulee",
        "non_realise"
      ],
      "default": "planifiee"
    },
    "facturation_statut": {
      "type": "string",
      "enum": [
        "non_facture",
        "facture",
        "hors_facturation"
      ],
      "default": "non_facture",
      "description": "Statut de facturation du service"
    },
    "agents_required": {
      "type": "number",
      "default": 1,
      "description": "Nombre de collaborateurs n\u00e9cessaires pour ce service"
    },
    "notes": {
      "type": "string"
    },
    "report": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "company_id"
  ]
}