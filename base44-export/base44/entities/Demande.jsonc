{
  "name": "Demande",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "from_type": {
      "type": "string",
      "enum": [
        "client",
        "agent"
      ],
      "default": "client"
    },
    "from_id": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nouvelle",
        "en_cours",
        "resolue",
        "fermee"
      ],
      "default": "nouvelle"
    },
    "priority": {
      "type": "string",
      "enum": [
        "basse",
        "normale",
        "haute",
        "urgente"
      ],
      "default": "normale"
    },
    "response": {
      "type": "string"
    },
    "responded_at": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "from_type",
    "subject",
    "message"
  ]
}