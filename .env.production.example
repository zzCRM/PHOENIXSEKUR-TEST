# Copier vers .env.production sur le serveur OVH
# cp .env.production.example .env.production

# ─── Domaine ───────────────────────────────────────────────────────────────
DOMAIN=app.phoenixsekur.com
VITRINE_DOMAIN=www.phoenixsekur.com
ROOT_DOMAIN=phoenixsekur.com
VITRINE_URL=https://www.phoenixsekur.com
COOKIE_DOMAIN=.phoenixsekur.com
ACME_EMAIL=serviceclient@ppsecurity.fr

# ─── Sécurité (GÉNÉRER DES VALEURS UNIQUES !) ───────────────────────────────
# openssl rand -hex 32
POSTGRES_PASSWORD=change-me-strong-password-here
JWT_SECRET=change-me-jwt-secret-min-32-chars

# ─── Super Admin plateforme (rôle superadmin en base uniquement) ───────────
# Compte dédié gestion plateforme — distinct des admins société
SUPER_ADMIN_EMAILS=admin@phoenixsekur.fr

# ─── Admins société (rôle admin — PAS Super Admin plateforme) ───────────────
COMPANY_ADMIN_EMAILS=serviceclient@ppsecurity.fr,contact@ppsecurity.fr

# ─── Compte Super Admin initial (1er déploiement uniquement) ────────────────
ADMIN_EMAIL=admin@phoenixsekur.fr
ADMIN_ROLE=superadmin
ADMIN_PASSWORD=ChangeMe2026!
ADMIN_COMPANY_ID=69edb44339460eb505c2a699

# ─── Optionnel ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Email (invitations utilisateurs) ───────────────────────────────────────
# Exemple OVH : SMTP_HOST=ssl0.ovh.net  SMTP_PORT=465
# Exemple IONOS : SMTP_HOST=smtp.ionos.fr  SMTP_PORT=587
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=contact@phoenixsekur.com
SMTP_PASS=
SMTP_FROM="Phoenix Sekur <contact@phoenixsekur.com>"
